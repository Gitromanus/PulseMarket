{
  "name": "pulsemarket-ui",
  "version": "0.1.0",
  "private": true,
  "description": "PulseMarket — рабочее окно и настройки",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "node scripts/start-electron.mjs",
    "dev": "npm run build && node scripts/start-electron.mjs",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-installer.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "ru.pulsemarket.app",
    "productName": "PulseMarket",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**"],
    "extraResources": [
      { "from": "../build/backend/pf-backend.dist", "to": "backend" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "PulseMarket-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PulseMarket",
      "deleteAppDataOnUninstall": false
    }
  }
}
